from sklearn.model_selection import GridSearchCV

param_grid = {
    'n_estimators': [300, 500,700,900,1000],
    'max_depth': [6, 8, 10,12,14],
    'min_samples_leaf': [3, 5, 10]
}

rf = RandomForestClassifier(
    class_weight='balanced',
    random_state=42
)

grid = GridSearchCV(
    rf,
    param_grid,
    scoring='roc_auc',
    cv=5,
    n_jobs=-1
)


    param_grid,
    scoring='roc_auc',
    cv=5,
    n_jobs=-1
)

grid.fit(X_train, y_train)

best_xgb = grid.best_estimator_

y_prob = best_xgb.predict_proba(X_test)[:,1]
print("Best XGBoost AUC:", roc_auc_score(y_test, y_prob))


